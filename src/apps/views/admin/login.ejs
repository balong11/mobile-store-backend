<%- include('layout/head') %>


	
	<div class="row">
		<div class="col-xs-10 col-xs-offset-1 col-sm-8 col-sm-offset-2 col-md-4 col-md-offset-4">
			<div class="login-panel panel panel-default">
				<div class="panel-heading">Long Mobile Shop - Administrator</div>
				<div class="panel-body">
					<% if(error){%>
						<div class="alert alert-danger"><%= error%></div>
					<% }%>
					<form role="form" method="post">
						<fieldset>
							<div class="form-group">
								<input class="form-control" placeholder="E-mail" name="email" type="email" autofocus value="<%= rememberEmail || '' %>">
							</div>
							<div class="form-group">
								<input class="form-control" placeholder="Mật khẩu" name="password" type="password" value="<%= rememberPassword || '' %>">
							</div>
							<div class="checkbox">
								<label>
									<input name="rememberMe" type="checkbox" value="1" <%= (rememberEmail && rememberPassword) ? 'checked' : '' %>>Ghi nhớ tài khoản
								</label>
							</div>
							<button type="submit" class="btn btn-primary">Đăng nhập</button>
						</fieldset>
					</form>
				</div>
			</div>
		</div><!-- /.col-->
	</div><!-- /.row -->	

	</div><!--/.main-->