<%- include('../layout/head') %>
<%- include('../layout/header') %>
<%- include('../layout/sidebar') %>

<div class="col-sm-9 col-sm-offset-3 col-lg-10 col-lg-offset-2 main">
  <div class="row">
    <ol class="breadcrumb">
      <li><a href="/admin/dashboard"><svg class="glyph stroked home"><use xlink:href="#stroked-home"></use></svg></a></li>
      <li class="active">Cấu hình</li>
    </ol>
  </div>

  <div class="row">
    <div class="col-lg-12">
      <h1 class="page-header">Cấu hình chung</h1>
    </div>
  </div>

  <div class="row">
    <div class="col-lg-8">
      <form action="/admin/settings" method="post" enctype="multipart/form-data">
        <div class="form-group">
          <label for="site_name">Tên website</label>
          <input type="text" id="site_name" name="site_name" class="form-control" value="<%= setting ? setting.site_name : '' %>" />
        </div>

        <div class="form-group">
          <label for="footer_text">Footer</label>
          <textarea id="footer_text" name="footer_text" rows="3" class="form-control"><%= setting ? setting.footer_text : '' %></textarea>
        </div>

        <div class="form-group">
          <label for="logo">Logo</label>
          <input type="file" id="logo" name="logo" class="form-control" accept="image/*" />
          <% if (setting && setting.logo) { %>
            <div style="margin-top:10px">
              <img src="/static/uploads/<%= setting.logo %>" alt="Logo" style="max-height:60px" />
              <form action="/admin/settings/logo/delete" method="post" style="display:inline-block;margin-left:10px">
                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Xóa logo hiện tại?');">Xóa logo</button>
              </form>
            </div>
          <% } %>
        </div>

        <button type="submit" class="btn btn-primary">Lưu</button>
      </form>
    </div>
  </div>
</div>

<%- include('../layout/footer') %>


