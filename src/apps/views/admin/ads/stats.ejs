<%- include('../layout/head') %>

<%- include('../layout/header') %>

<%- include('../layout/sidebar') %>
	<div class="col-sm-9 col-sm-offset-3 col-lg-10 col-lg-offset-2 main">			
		<div class="row">
			<ol class="breadcrumb">
				<li><a href="/admin/dashboard"><svg class="glyph stroked home"><use xlink:href="#stroked-home"></use></svg></a></li>
				<li><a href="/admin/ads">Quảng cáo</a></li>
				<li class="active">Thống kê</li>
			</ol>
		</div><!--/.row-->
		
		<div class="row">
			<div class="col-lg-12">
				<h1 class="page-header">Thống kê quảng cáo</h1>
			</div>
		</div><!--/.row-->

		<div class="row">
			<div class="col-lg-3 col-md-6">
				<div class="panel panel-primary">
					<div class="panel-heading">
						<div class="row">
							<div class="col-xs-3">
								<i class="fa fa-comments fa-5x"></i>
							</div>
							<div class="col-xs-9 text-right">
								<div class="huge"><%= totalAds %></div>
								<div>Tổng số quảng cáo</div>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="col-lg-3 col-md-6">
				<div class="panel panel-green">
					<div class="panel-heading">
						<div class="row">
							<div class="col-xs-3">
								<i class="fa fa-toggle-on fa-5x"></i>
							</div>
							<div class="col-xs-9 text-right">
								<div class="huge"><%= activeAds %></div>
								<div>Quảng cáo đang bật</div>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="col-lg-3 col-md-6">
				<div class="panel panel-yellow">
					<div class="panel-heading">
						<div class="row">
							<div class="col-xs-3">
								<i class="fa fa-toggle-off fa-5x"></i>
							</div>
							<div class="col-xs-9 text-right">
								<div class="huge"><%= inactiveAds %></div>
								<div>Quảng cáo đang tắt</div>
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="col-lg-3 col-md-6">
				<div class="panel panel-info">
					<div class="panel-heading">
						<div class="row">
							<div class="col-xs-3">
								<i class="fa fa-image fa-5x"></i>
							</div>
							<div class="col-xs-9 text-right">
								<div class="huge"><%= sliderAds %></div>
								<div>Quảng cáo Slider</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div><!--/.row-->

		<div class="row">
			<div class="col-lg-6">
				<div class="panel panel-default">
					<div class="panel-heading">
						<i class="fa fa-bar-chart-o fa-fw"></i> Thống kê theo loại quảng cáo
					</div>
					<div class="panel-body">
						<div class="row">
							<div class="col-md-6">
								<div class="well">
									<h4>Quảng cáo Banner</h4>
									<h2 class="text-primary"><%= bannerAds.toLocaleString() %></h2>
								</div>
							</div>
							<div class="col-md-6">
								<div class="well">
									<h4>Quảng cáo Slider</h4>
									<h2 class="text-success"><%= sliderAds.toLocaleString() %></h2>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
			
			<div class="col-lg-6">
				<div class="panel panel-default">
					<div class="panel-heading">
						<i class="fa fa-clock-o fa-fw"></i> Thông tin hệ thống
					</div>
					<div class="panel-body">
						<div class="list-group">
							<a href="/admin/ads" class="list-group-item">
								<i class="fa fa-list fa-fw"></i> Xem danh sách quảng cáo
							</a>
							<a href="/admin/ads/create" class="list-group-item">
								<i class="fa fa-plus fa-fw"></i> Thêm quảng cáo mới
							</a>
						</div>
					</div>
				</div>
			</div>
		</div><!--/.row-->	
	</div>	<!--/.main-->

	<script src="js/jquery-1.11.1.min.js"></script>
	<script src="js/bootstrap.min.js"></script>
<%- include('../layout/footer') %>
