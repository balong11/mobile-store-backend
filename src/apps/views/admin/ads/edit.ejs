<%- include('../layout/head') %>

<%- include('../layout/header') %>

<%- include('../layout/sidebar') %>
	<div class="col-sm-9 col-sm-offset-3 col-lg-10 col-lg-offset-2 main">			
		<div class="row">
			<ol class="breadcrumb">
				<li><a href="/admin/dashboard"><svg class="glyph stroked home"><use xlink:href="#stroked-home"></use></svg></a></li>
				<li><a href="/admin/ads">Quảng cáo</a></li>
				<li class="active">Chỉnh sửa quảng cáo</li>
			</ol>
		</div><!--/.row-->
		
		<div class="row">
			<div class="col-lg-12">
				<h1 class="page-header">Chỉnh sửa quảng cáo</h1>
			</div>
		</div><!--/.row-->

		<div class="row">
			<div class="col-lg-12">
				<div class="panel panel-default">
					<div class="panel-heading">Thông tin quảng cáo</div>
					<div class="panel-body">
						<% if (typeof error !== 'undefined' && error) { %>
							<div class="alert alert-danger">
								<%= error %>
							</div>
						<% } %>
						
                        <form action="/admin/ads/update/<%= ads._id %>" method="POST" enctype="multipart/form-data">
                            <div class="form-group">
                                <label>Ảnh quảng cáo</label>
                                <% if (ads.image) { %>
                                  <div style="margin-bottom:8px">
                                    <img src="../uploads/<%= ads.image %>" alt="ads image" style="max-width:180px;border:1px solid #eee;border-radius:4px;" />
                                  </div>
                                <% } %>
                                <input type="file" class="form-control" name="image" accept="image/*">
                            </div>
							<div class="form-group">
								<label>Tiêu đề quảng cáo *</label>
								<input type="text" class="form-control" name="title" value="<%= ads.title %>" required>
							</div>
							
							<div class="form-group">
								<label>Mô tả *</label>
								<textarea class="form-control" name="description" rows="3" required><%= ads.description %></textarea>
							</div>
							
							<div class="form-group">
								<label>Liên kết</label>
								<input type="url" class="form-control" name="link" value="<%= ads.link %>" placeholder="https://example.com">
							</div>
							
							<div class="form-group">
								<label>Loại quảng cáo *</label>
								<select class="form-control" name="type" required>
									<option value="banner" <%= ads.type === 'banner' ? 'selected' : '' %>>Banner</option>
									<option value="slider" <%= ads.type === 'slider' ? 'selected' : '' %>>Slider</option>
								</select>
							</div>
							
							<div class="form-group">
								<label>Trạng thái *</label>
								<select class="form-control" name="status" required>
									<option value="on" <%= ads.status === 'on' ? 'selected' : '' %>>Bật</option>
									<option value="off" <%= ads.status === 'off' ? 'selected' : '' %>>Tắt</option>
								</select>
							</div>
							
							<div class="form-group">
								<button type="submit" class="btn btn-primary">Cập nhật quảng cáo</button>
								<a href="/admin/ads" class="btn btn-default">Hủy</a>
							</div>
						</form>
					</div>
				</div>
			</div>
		</div><!--/.row-->	
	</div>	<!--/.main-->

	<script src="js/jquery-1.11.1.min.js"></script>
	<script src="js/bootstrap.min.js"></script>
<%- include('../layout/footer') %>
