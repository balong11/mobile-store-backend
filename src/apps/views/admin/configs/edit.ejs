<%- include('../layout/head') %>

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title">
                        <i class="fa fa-edit"></i> Chỉnh sửa cấu hình
                    </h3>
                </div>
                <div class="panel-body">
                    <form action="/admin/configs/edit/<%= config._id %>" method="POST" enctype="multipart/form-data">
                        <div class="row">
                            <!-- Thông tin cơ bản -->
                            <div class="col-md-6">
                                <h4><i class="fa fa-info-circle"></i> Thông tin cơ bản</h4>
                                
                                <div class="form-group">
                                    <label for="logo">Logo website:</label>
                                    <% if (config.logo) { %>
                                        <div class="current-logo mb-2">
                                            <img src="<%= config.logo %>" alt="Logo hiện tại" style="max-width: 100px; max-height: 100px;">
                                            <small class="text-muted d-block">Logo hiện tại</small>
                                        </div>
                                    <% } %>
                                    <input type="file" class="form-control" id="logo" name="logo" accept="image/*">
                                    <small class="text-muted">Để trống nếu không muốn thay đổi logo. Định dạng: JPG, PNG, GIF. Kích thước tối đa: 2MB</small>
                                </div>
                                
                                <div class="form-group">
                                    <label for="logoText">Tên hiển thị:</label>
                                    <input type="text" class="form-control" id="logoText" name="logoText" value="<%= config.logoText || '' %>" placeholder="Nhập tên hiển thị">
                                </div>
                                
                                <div class="form-group">
                                    <label for="status">Trạng thái:</label>
                                    <select class="form-control" id="status" name="status">
                                        <option value="active" <%= config.status === 'active' ? 'selected' : '' %>>Kích hoạt</option>
                                        <option value="inactive" <%= config.status === 'inactive' ? 'selected' : '' %>>Không kích hoạt</option>
                                    </select>
                                </div>
                            </div>
                            
                            <!-- Thông tin Footer -->
                            <div class="col-md-6">
                                <h4><i class="fa fa-building"></i> Thông tin Footer</h4>
                                
                                <div class="form-group">
                                    <label for="companyName">Tên công ty:</label>
                                    <input type="text" class="form-control" id="companyName" name="footer[companyName]" value="<%= config.footer.companyName || '' %>" placeholder="Nhập tên công ty">
                                </div>
                                
                                <div class="form-group">
                                    <label for="description">Mô tả:</label>
                                    <textarea class="form-control" id="description" name="footer[description]" rows="3" placeholder="Nhập mô tả công ty"><%= config.footer.description || '' %></textarea>
                                </div>
                                
                                <div class="form-group">
                                    <label for="address">Địa chỉ:</label>
                                    <input type="text" class="form-control" id="address" name="footer[address]" value="<%= config.footer.address || '' %>" placeholder="Nhập địa chỉ">
                                </div>
                                
                                <div class="form-group">
                                    <label for="phone">Điện thoại:</label>
                                    <input type="text" class="form-control" id="phone" name="footer[phone]" value="<%= config.footer.phone || '' %>" placeholder="Nhập số điện thoại">
                                </div>
                                
                                <div class="form-group">
                                    <label for="email">Email:</label>
                                    <input type="email" class="form-control" id="email" name="footer[email]" value="<%= config.footer.email || '' %>" placeholder="Nhập email">
                                </div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <!-- Mạng xã hội -->
                            <div class="col-md-6">
                                <h4><i class="fa fa-share-alt"></i> Mạng xã hội</h4>
                                
                                <div class="form-group">
                                    <label for="facebook">Facebook:</label>
                                    <input type="url" class="form-control" id="facebook" name="footer[facebook]" value="<%= config.footer.facebook || '' %>" placeholder="https://facebook.com/...">
                                </div>
                                
                                <div class="form-group">
                                    <label for="instagram">Instagram:</label>
                                    <input type="url" class="form-control" id="instagram" name="footer[instagram]" value="<%= config.footer.instagram || '' %>" placeholder="https://instagram.com/...">
                                </div>
                                
                                <div class="form-group">
                                    <label for="youtube">YouTube:</label>
                                    <input type="url" class="form-control" id="youtube" name="footer[youtube]" value="<%= config.footer.youtube || '' %>" placeholder="https://youtube.com/...">
                                </div>
                            </div>
                            
                            <!-- Thông tin liên hệ -->
                            <div class="col-md-6">
                                <h4><i class="fa fa-phone"></i> Thông tin liên hệ</h4>
                                
                                <div class="form-group">
                                    <label for="hotline">Hotline:</label>
                                    <input type="text" class="form-control" id="hotline" name="contact[hotline]" value="<%= config.contact.hotline || '' %>" placeholder="Nhập số hotline">
                                </div>
                                
                                <div class="form-group">
                                    <label for="supportEmail">Email hỗ trợ:</label>
                                    <input type="email" class="form-control" id="supportEmail" name="contact[supportEmail]" value="<%= config.contact.supportEmail || '' %>" placeholder="Nhập email hỗ trợ">
                                </div>
                                
                                <div class="form-group">
                                    <label for="workingHours">Giờ làm việc:</label>
                                    <input type="text" class="form-control" id="workingHours" name="contact[workingHours]" value="<%= config.contact.workingHours || '' %>" placeholder="Nhập giờ làm việc">
                                </div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <!-- SEO -->
                            <div class="col-md-12">
                                <h4><i class="fa fa-search"></i> Thông tin SEO</h4>
                                
                                <div class="form-group">
                                    <label for="seoTitle">Tiêu đề SEO:</label>
                                    <input type="text" class="form-control" id="seoTitle" name="seo[title]" value="<%= config.seo.title || '' %>" placeholder="Nhập tiêu đề SEO">
                                </div>
                                
                                <div class="form-group">
                                    <label for="seoDescription">Mô tả SEO:</label>
                                    <textarea class="form-control" id="seoDescription" name="seo[description]" rows="3" placeholder="Nhập mô tả SEO"><%= config.seo.description || '' %></textarea>
                                </div>
                                
                                <div class="form-group">
                                    <label for="seoKeywords">Từ khóa SEO:</label>
                                    <input type="text" class="form-control" id="seoKeywords" name="seo[keywords]" value="<%= config.seo.keywords || '' %>" placeholder="Nhập từ khóa SEO, phân cách bằng dấu phẩy">
                                </div>
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-12">
                                <hr>
                                <div class="form-group">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fa fa-save"></i> Cập nhật cấu hình
                                    </button>
                                    <a href="/admin/configs" class="btn btn-default">
                                        <i class="fa fa-arrow-left"></i> Quay lại
                                    </a>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
$(document).ready(function() {
    // Preview logo
    $('#logo').change(function() {
        const file = this.files[0];
        if (file) {
            if (file.size > 2 * 1024 * 1024) {
                alert('File quá lớn! Kích thước tối đa là 2MB.');
                this.value = '';
                return;
            }
            
            const reader = new FileReader();
            reader.onload = function(e) {
                // Có thể hiển thị preview ở đây nếu cần
            };
            reader.readAsDataURL(file);
        }
    });
});
</script>

<%- include('../layout/footer') %> 