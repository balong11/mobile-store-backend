<%- include('../layout/head') %>

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h3 class="panel-title">
                        <i class="fa fa-cogs"></i> Quản lý cấu hình website
                    </h3>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-md-12">
                            <a href="/admin/configs/add" class="btn btn-primary">
                                <i class="fa fa-plus"></i> Thêm cấu hình mới
                            </a>
                        </div>
                    </div>
                    <br>
                    
                    <% if (typeof messages !== 'undefined' && messages.success) { %>
                        <div class="alert alert-success alert-dismissible" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                            <%= messages.success %>
                        </div>
                    <% } %>
                    
                    <% if (typeof messages !== 'undefined' && messages.error) { %>
                        <div class="alert alert-danger alert-dismissible" role="alert">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                            <%= messages.error %>
                        </div>
                    <% } %>

                    <div class="table-responsive">
                        <table class="table table-striped table-bordered table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Logo</th>
                                    <th>Tên công ty</th>
                                    <th>Địa chỉ</th>
                                    <th>Điện thoại</th>
                                    <th>Trạng thái</th>
                                    <th>Ngày tạo</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (configs && configs.length > 0) { %>
                                    <% configs.forEach(function(config) { %>
                                        <tr>
                                            <td><%= config._id %></td>
                                            <td>
                                                <% if (config.logo) { %>
                                                    <img src="<%= config.logo %>" alt="Logo" style="max-width: 50px; max-height: 50px;">
                                                <% } else { %>
                                                    <span class="text-muted">Không có logo</span>
                                                <% } %>
                                            </td>
                                            <td><%= config.footer.companyName %></td>
                                            <td><%= config.footer.address %></td>
                                            <td><%= config.footer.phone %></td>
                                            <td>
                                                <span class="label label-<%= config.status === 'active' ? 'success' : 'danger' %>">
                                                    <%= config.status === 'active' ? 'Kích hoạt' : 'Không kích hoạt' %>
                                                </span>
                                            </td>
                                            <td><%= new Date(config.createdAt).toLocaleDateString('vi-VN') %></td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a href="/admin/configs/edit/<%= config._id %>" class="btn btn-sm btn-warning">
                                                        <i class="fa fa-edit"></i> Sửa
                                                    </a>
                                                    <button type="button" class="btn btn-sm btn-<%= config.status === 'active' ? 'info' : 'success' %> toggle-status" 
                                                            data-id="<%= config._id %>" data-status="<%= config.status %>">
                                                        <i class="fa fa-<%= config.status === 'active' ? 'pause' : 'play' %>"></i>
                                                        <%= config.status === 'active' ? 'Tạm dừng' : 'Kích hoạt' %>
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-danger delete-config" data-id="<%= config._id %>">
                                                        <i class="fa fa-trash"></i> Xóa
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="8" class="text-center">Không có cấu hình nào</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
$(document).ready(function() {
    // Xử lý thay đổi trạng thái
    $('.toggle-status').click(function() {
        const id = $(this).data('id');
        const currentStatus = $(this).data('status');
        
        $.ajax({
            url: `/admin/configs/toggle-status/${id}`,
            method: 'POST',
            success: function(response) {
                if (response.success) {
                    location.reload();
                } else {
                    alert('Lỗi: ' + response.error);
                }
            },
            error: function() {
                alert('Lỗi server!');
            }
        });
    });
    
    // Xử lý xóa cấu hình
    $('.delete-config').click(function() {
        if (confirm('Bạn có chắc chắn muốn xóa cấu hình này?')) {
            const id = $(this).data('id');
            
            $.ajax({
                url: `/admin/configs/delete/${id}`,
                method: 'DELETE',
                success: function(response) {
                    if (response.success) {
                        location.reload();
                    } else {
                        alert('Lỗi: ' + response.error);
                    }
                },
                error: function() {
                    alert('Lỗi server!');
                }
            });
        }
    });
});
</script>

<%- include('../layout/footer') %> 